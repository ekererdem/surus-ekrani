<?xml version="1.0" encoding="utf-8"?>
<!-- Yatay: solda saat paneli, sağda iki dev buton ve kısayollar -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@color/bg"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="@drawable/field_bg"
        android:padding="20dp">

        <TextClock
            android:id="@+id/clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="HH:mm"
            android:format24Hour="HH:mm"
            android:fontFamily="sans-serif-condensed"
            android:textStyle="bold"
            android:textSize="96sp"
            android:textColor="@color/fg"
            android:includeFontPadding="false" />

        <TextClock
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="EEEE, d MMMM"
            android:format24Hour="EEEE, d MMMM"
            android:textSize="20sp"
            android:textColor="@color/muted"
            android:layout_marginTop="6dp" />

        <Space android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />

        <Button android:id="@+id/appsBtn" style="@style/OutlineBtn"
            android:layout_width="match_parent" android:text="Uygulamalar" />
        <Button android:id="@+id/settingsBtn" style="@style/OutlineBtn"
            android:layout_width="match_parent" android:layout_marginTop="10dp" android:text="Ayarlar" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="2"
        android:layout_marginStart="14dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/navTile"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/tile_amber"
                android:padding="22dp"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:src="@drawable/ic_nav"
                    android:tint="@color/amber_ink"
                    android:contentDescription="@null" />
                <Space android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
                <TextView style="@style/TileTitle" android:text="Navigasyon" android:textColor="@color/amber_ink" />
                <TextView android:id="@+id/navSub" style="@style/TileSub" android:textColor="@color/amber_ink" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/musicTile"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:orientation="vertical"
                android:background="@drawable/tile_dark"
                android:padding="22dp"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:src="@drawable/ic_music"
                    android:tint="@color/fg"
                    android:contentDescription="@null" />
                <Space android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
                <TextView style="@style/TileTitle" android:text="Müzik" android:textColor="@color/fg" />
                <TextView android:id="@+id/musicSub" style="@style/TileSub" android:textColor="@color/fg" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/homeChip"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="84dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/chip_bg"
                android:paddingStart="18dp"
                android:paddingEnd="14dp"
                android:clickable="true"
                android:focusable="true">
                <ImageView android:layout_width="28dp" android:layout_height="28dp"
                    android:src="@drawable/ic_home" android:tint="@color/amber" android:contentDescription="@null" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical">
                    <TextView style="@style/ChipTitle" android:text="Eve git" />
                    <TextView android:id="@+id/homeSub" style="@style/ChipSub" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/workChip"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:minHeight="84dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/chip_bg"
                android:paddingStart="18dp"
                android:paddingEnd="14dp"
                android:clickable="true"
                android:focusable="true">
                <ImageView android:layout_width="28dp" android:layout_height="28dp"
                    android:src="@drawable/ic_work" android:tint="@color/amber" android:contentDescription="@null" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical">
                    <TextView style="@style/ChipTitle" android:text="İşe git" />
                    <TextView android:id="@+id/workSub" style="@style/ChipSub" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
