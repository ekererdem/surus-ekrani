<?xml version="1.0" encoding="utf-8"?>
<!-- Üst satır: saat + hava durumu, tarih; sağda Bluetooth/pil ve küçük simgeler -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextClock
                android:id="@+id/clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="HH:mm"
                android:format24Hour="HH:mm"
                android:fontFamily="sans-serif-condensed"
                android:textStyle="bold"
                android:textSize="52sp"
                android:textColor="@color/fg"
                android:includeFontPadding="false" />
            <TextView
                android:id="@+id/weatherTemp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:fontFamily="sans-serif-condensed"
                android:textSize="26sp"
                android:textColor="@color/fg"
                android:singleLine="true"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:orientation="horizontal">
            <TextClock
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="EEEE, d MMMM"
                android:format24Hour="EEEE, d MMMM"
                android:textSize="15sp"
                android:textColor="@color/muted"
                android:singleLine="true" />
            <TextView
                android:id="@+id/weatherDesc"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="15sp"
                android:textColor="@color/muted"
                android:singleLine="true"
                android:ellipsize="end"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="end">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <ImageView
                android:id="@+id/btIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="10dp"
                android:src="@drawable/ic_bluetooth"
                android:tint="@color/muted"
                android:visibility="gone"
                android:contentDescription="Bluetooth" />
            <ImageView
                android:id="@+id/battIcon"
                android:layout_width="30dp"
                android:layout_height="23dp"
                android:src="@drawable/ic_battery"
                android:tint="@color/muted"
                android:contentDescription="Pil" />
            <TextView
                android:id="@+id/battText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:textSize="17sp"
                android:textColor="@color/muted"
                android:fontFeatureSettings="tnum" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Plaka -->
            <LinearLayout
                android:id="@+id/plate"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="10dp"
                android:orientation="horizontal"
                android:background="@drawable/plate_bg"
                android:padding="1.5dp"
                android:elevation="2dp">
                <TextView
                    android:layout_width="15dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/plate_band"
                    android:gravity="bottom|center_horizontal"
                    android:paddingBottom="2dp"
                    android:text="TR"
                    android:textColor="#FFFFFF"
                    android:textSize="7sp"
                    android:textStyle="bold"
                    android:includeFontPadding="false" />
                <TextView
                    android:id="@+id/plateText"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:paddingStart="7dp"
                    android:paddingEnd="8dp"
                    android:fontFamily="sans-serif-condensed"
                    android:textStyle="bold"
                    android:textSize="19sp"
                    android:letterSpacing="0.04"
                    android:textColor="#151515"
                    android:singleLine="true"
                    android:includeFontPadding="false"
                    android:text="06 GE 6501" />
            </LinearLayout>

            <include
                layout="@layout/part_icons"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
