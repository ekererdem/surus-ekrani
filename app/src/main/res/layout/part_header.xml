<?xml version="1.0" encoding="utf-8"?>
<!-- Üst bölüm: 1. satır hava + hız | durum simgeleri; 2. satır eşit boyda düğmeler -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Saat ve tarih gizli: arabanın kendi saati var. Kimlikleri kod için duruyor. -->
        <TextClock
            android:id="@+id/clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <!-- Hava durumu -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:id="@+id/weatherTemp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-condensed"
                android:textSize="28sp"
                android:textColor="@color/fg"
                android:singleLine="true"
                android:includeFontPadding="false"
                android:visibility="gone" />
            <TextView
                android:id="@+id/weatherDesc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="14sp"
                android:textColor="@color/muted"
                android:singleLine="true"
                android:visibility="gone" />
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="40dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:background="@color/line" />

        <!-- Hız -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="bottom">
            <TextView
                android:id="@+id/speedText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="42dp"
                android:gravity="end"
                android:fontFamily="sans-serif-condensed"
                android:textStyle="bold"
                android:textSize="38sp"
                android:textColor="@color/fg"
                android:fontFeatureSettings="tnum"
                android:includeFontPadding="false"
                android:text="0" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:layout_marginBottom="3dp"
                android:textSize="13sp"
                android:textColor="@color/muted"
                android:text="km/s" />
        </LinearLayout>

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Durum simgeleri -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <ImageView
                android:id="@+id/signalIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="10dp"
                android:src="@drawable/ic_signal_0"
                android:tint="@color/muted"
                android:contentDescription="Şebeke çekimi" />
            <ImageView
                android:id="@+id/btIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="10dp"
                android:src="@drawable/ic_bluetooth"
                android:tint="@color/muted"
                android:visibility="gone"
                android:contentDescription="Bluetooth" />
            <ImageView
                android:id="@+id/battIcon"
                android:layout_width="30dp"
                android:layout_height="23dp"
                android:src="@drawable/battery_level"
                android:tint="@color/muted"
                android:contentDescription="Pil" />
            <TextView
                android:id="@+id/battText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:textSize="17sp"
                android:textColor="@color/muted"
                android:fontFeatureSettings="tnum" />
        </LinearLayout>
    </LinearLayout>

    <include
        layout="@layout/part_icons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp" />
</LinearLayout>
