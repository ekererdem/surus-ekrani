<?xml version="1.0" encoding="utf-8"?>
<!-- Üst satır gizli: durum simgeleri düğme alanına taşındı. Kimlikler kod için duruyor. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Saat ve tarih gizli: arabanın kendi saati var. Kimlikleri kod için duruyor. -->
        <TextClock
            android:id="@+id/clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <!-- Hava durumu (gizli) -->
        <LinearLayout
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:id="@+id/weatherTemp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-condensed"
                android:textSize="28sp"
                android:textColor="@color/fg"
                android:singleLine="true"
                android:includeFontPadding="false"
                android:visibility="gone" />
            <TextView
                android:id="@+id/weatherDesc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="14sp"
                android:textColor="@color/muted"
                android:singleLine="true"
                android:visibility="gone" />
        </LinearLayout>

        <View
            android:visibility="gone"
            android:layout_width="1dp"
            android:layout_height="40dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:background="@color/line" />

        <!-- Hız (gizli; konum takibi park yeri için arka planda sürüyor) -->
        <LinearLayout
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="bottom">
            <TextView
                android:id="@+id/speedText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="42dp"
                android:gravity="end"
                android:fontFamily="sans-serif-condensed"
                android:textStyle="bold"
                android:textSize="38sp"
                android:textColor="@color/fg"
                android:fontFeatureSettings="tnum"
                android:includeFontPadding="false"
                android:text="0" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:layout_marginBottom="3dp"
                android:textSize="13sp"
                android:textColor="@color/muted"
                android:text="km/s" />
        </LinearLayout>

    </LinearLayout>
</LinearLayout>
