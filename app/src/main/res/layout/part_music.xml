<?xml version="1.0" encoding="utf-8"?>
<!-- Müzik kutusu: üstte tüm genişlikte şarkı ve nereden çaldığı; altta solda albüm kapağı
     (sağdaki tuşlar kadar yüksek), sağda ilerleme çubuğu ve tuşlar -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/musicTile"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/tile_dark"
    android:paddingStart="12dp"
    android:paddingEnd="14dp"
    android:paddingTop="6dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:id="@+id/musicOpen"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:id="@+id/songTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textSize="19sp"
            android:textStyle="bold"
            android:textColor="@color/fg"
            android:singleLine="true"
            android:ellipsize="end"
            android:text="Müzik" />

        <TextView
            android:id="@+id/songArtist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textSize="12sp"
            android:textColor="@color/muted"
            android:singleLine="true"
            android:ellipsize="end" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/musicBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/musicArt"
            android:layout_width="132dp"
            android:layout_height="132dp"
            android:background="@drawable/art_bg"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_music"
            android:padding="24dp"
            android:tint="@color/muted"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Albüm kapağı" />

        <LinearLayout
            android:id="@+id/musicControls"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:orientation="vertical">

            <SeekBar
                android:id="@+id/musicSeek"
                android:layout_width="match_parent"
                android:layout_height="24dp"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:max="1000"
                android:progressTint="?attr/kAccent"
                android:progressBackgroundTint="@color/line"
                android:thumbTint="?attr/kAccent" />

            <!-- Süreler; ortada müzik uygulamasının kendi tuşları (Spotify: beğen, öneriyi kaldır…) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:id="@+id/musicElapsed"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="13sp"
                    android:textColor="@color/muted"
                    android:fontFeatureSettings="tnum"
                    android:text="0:00" />
                <LinearLayout
                    android:id="@+id/musicActions"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:visibility="gone" />
                <TextView
                    android:id="@+id/musicDuration"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:textSize="13sp"
                    android:textColor="@color/muted"
                    android:fontFeatureSettings="tnum"
                    android:text="0:00" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/prevBtn"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/btn_outline"
                    android:src="@drawable/ic_prev"
                    android:tint="@color/fg"
                    android:scaleType="center"
                    android:contentDescription="Önceki" />

                <ImageButton
                    android:id="@+id/playBtn"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1.2"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/tile_accent"
                    android:src="@drawable/ic_play"
                    android:tint="?attr/kAccentInk"
                    android:scaleType="center"
                    android:contentDescription="Oynat / Duraklat" />

                <ImageButton
                    android:id="@+id/nextBtn"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/btn_outline"
                    android:src="@drawable/ic_next"
                    android:tint="@color/fg"
                    android:scaleType="center"
                    android:contentDescription="Sonraki" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
