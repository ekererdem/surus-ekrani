<?xml version="1.0" encoding="utf-8"?>
<!-- Dikey: saat üstte, iki dev buton ortada, kısayollar altta -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg"
    android:padding="16dp">

    <TextClock
        android:id="@+id/clock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:format12Hour="HH:mm"
        android:format24Hour="HH:mm"
        android:fontFamily="sans-serif-condensed"
        android:textStyle="bold"
        android:textSize="88sp"
        android:textColor="@color/fg"
        android:includeFontPadding="false" />

    <TextClock
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:format12Hour="EEEE, d MMMM"
        android:format24Hour="EEEE, d MMMM"
        android:textSize="20sp"
        android:textColor="@color/muted"
        android:layout_marginTop="4dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="16dp"
        android:orientation="vertical">

        <include
            layout="@layout/part_nav"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <include
            layout="@layout/part_music"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="14dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/homeChip"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="84dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/chip_bg"
            android:paddingStart="18dp"
            android:paddingEnd="14dp"
            android:clickable="true"
            android:focusable="true">
            <ImageView android:layout_width="28dp" android:layout_height="28dp"
                android:src="@drawable/ic_home" android:tint="@color/amber" android:contentDescription="@null" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical">
                <TextView style="@style/ChipTitle" android:text="Eve git" />
                <TextView android:id="@+id/homeSub" style="@style/ChipSub" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/workChip"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:minHeight="84dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/chip_bg"
            android:paddingStart="18dp"
            android:paddingEnd="14dp"
            android:clickable="true"
            android:focusable="true">
            <ImageView android:layout_width="28dp" android:layout_height="28dp"
                android:src="@drawable/ic_work" android:tint="@color/amber" android:contentDescription="@null" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical">
                <TextView style="@style/ChipTitle" android:text="İşe git" />
                <TextView android:id="@+id/workSub" style="@style/ChipSub" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal">
        <Button android:id="@+id/appsBtn" style="@style/OutlineBtn"
            android:layout_width="0dp" android:layout_weight="1" android:text="Uygulamalar" />
        <Button android:id="@+id/settingsBtn" style="@style/OutlineBtn"
            android:layout_width="0dp" android:layout_weight="1" android:layout_marginStart="14dp"
            android:text="Ayarlar" />
    </LinearLayout>
</LinearLayout>
