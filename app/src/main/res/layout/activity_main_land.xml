<?xml version="1.0" encoding="utf-8"?>
<!-- Yatay, harita uygulamanın içinde: solda Kopilot, ortada sürüklenebilir çizgi, sağda harita (NavPanel) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/landRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@color/bg">

    <ScrollView
        android:id="@+id/leftCol"
        android:layout_width="380dp"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="4dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp">

            <include layout="@layout/part_header" />

            <include
                layout="@layout/part_nav"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:visibility="gone" />

            <include
                layout="@layout/part_icons"
                android:layout_width="match_parent"
                android:layout_height="104dp"
                android:layout_marginTop="6dp" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <include
                layout="@layout/part_music"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

            <include
                layout="@layout/part_shortcuts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp" />
        </LinearLayout>
    </ScrollView>

    <!-- Tutup sağa sola sürükle: Kopilot ile haritanın payını ayarlar -->
    <FrameLayout
        android:id="@+id/splitHandle"
        android:layout_width="20dp"
        android:layout_height="match_parent"
        android:background="?android:attr/selectableItemBackground"
        android:contentDescription="Kopilot ile harita arasındaki çizgi. Sürükleyerek genişliği ayarla">
        <View
            android:layout_width="5dp"
            android:layout_height="64dp"
            android:layout_gravity="center"
            android:background="@drawable/split_pill" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/mapHost"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:layout_marginEnd="10dp"
        android:background="@drawable/map_frame" />
</LinearLayout>
