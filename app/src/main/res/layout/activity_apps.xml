<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <ImageButton
            android:id="@+id/appsBack"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_back"
            android:tint="@color/fg"
            android:contentDescription="Geri" />
        <TextView
            android:id="@+id/appsTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/fg"
            android:singleLine="true"
            android:ellipsize="end"
            android:text="Uygulamalar" />
        <Button
            android:id="@+id/appsEdit"
            style="@style/OutlineBtn"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:textSize="16sp"
            android:text="Düzenle" />
    </LinearLayout>

    <TextView
        android:id="@+id/appsHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:textSize="15sp"
        android:textColor="@color/muted" />

    <GridView
        android:id="@+id/appsGrid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="10dp"
        android:numColumns="auto_fit"
        android:columnWidth="92dp"
        android:stretchMode="columnWidth"
        android:verticalSpacing="18dp"
        android:clipToPadding="false" />
</LinearLayout>
