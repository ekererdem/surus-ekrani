<?xml version="1.0" encoding="utf-8"?>
<!-- Hızlı düğmeler iki sıra halinde (hızlı rotalar koddan eklenir). Görünen düğmeler koddan iki sıraya eşit dağıtılır. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/iconsGrid"
    android:layout_width="match_parent"
    android:layout_height="104dp"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/iconsRow1"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- Bildirimler: WhatsApp/SMS mesajları ve cevapsız aramalar (kimden, kaç tane) -->
        <LinearLayout
            android:id="@+id/notifTile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="3"
            android:background="@drawable/btn_outline"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:id="@+id/notifIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:visibility="gone"
                android:contentDescription="@null" />
            <TextView
                android:id="@+id/notifText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:gravity="center_vertical"
                android:maxLines="2"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:textSize="15sp"
                android:textColor="@color/fg" />
        </LinearLayout>

        <!-- Hava: solda şimdi, sağda 1 saat sonra ya da varış yerinde (iki düğme genişliğinde) -->
        <LinearLayout
            android:id="@+id/weatherTile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="2"
            android:background="@drawable/btn_outline"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:contentDescription="Hava durumu">
            <TextView
                android:id="@+id/wNow"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:maxLines="2"
                android:includeFontPadding="false"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/fg"
                android:text="–" />
            <View
                android:layout_width="1dp"
                android:layout_height="26dp"
                android:background="@color/line" />
            <TextView
                android:id="@+id/wLater"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:gravity="center"
                android:maxLines="2"
                android:includeFontPadding="false"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/fg"
                android:text="–" />
        </LinearLayout>

        <!-- Durum: çekim, Bluetooth, pil (iki düğme genişliğinde) -->
        <LinearLayout
            android:id="@+id/statusTile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="2"
            android:background="@drawable/btn_outline"
            android:orientation="horizontal"
            android:gravity="center">
            <ImageView
                android:id="@+id/signalIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="8dp"
                android:src="@drawable/ic_signal_0"
                android:tint="@color/muted"
                android:contentDescription="Şebeke çekimi" />
            <ImageView
                android:id="@+id/btIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="8dp"
                android:src="@drawable/ic_bluetooth"
                android:tint="@color/muted"
                android:visibility="gone"
                android:contentDescription="Bluetooth" />
            <ImageView
                android:id="@+id/battIcon"
                android:layout_width="15dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_bolt"
                android:tint="@color/muted"
                android:contentDescription="Şarj" />
            <TextView
                android:id="@+id/battText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/muted"
                android:singleLine="true"
                android:fontFeatureSettings="tnum" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/assistBtn"
            style="@style/QuickIcon"
            android:src="@drawable/ic_mic"
            android:tint="@color/fg"
            android:contentDescription="Sesli asistan" />

        <TextView
            android:id="@+id/call1Btn"
            style="@style/QuickText"
            android:visibility="gone" />

        <TextView
            android:id="@+id/call2Btn"
            style="@style/QuickText"
            android:visibility="gone" />
        <TextView
            android:id="@+id/call3Btn"
            style="@style/QuickText"
            android:visibility="gone" />
        <TextView
            android:id="@+id/call4Btn"
            style="@style/QuickText"
            android:visibility="gone" />
        <TextView
            android:id="@+id/call5Btn"
            style="@style/QuickText"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/iconsRow2"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/parkBtn"
            style="@style/QuickIcon"
            android:src="@drawable/ic_car"
            android:tint="@color/fg"
            android:contentDescription="Arabam nerede" />

        <ImageButton
            android:id="@+id/settingsBtn"
            style="@style/QuickIcon"
            android:src="@drawable/ic_settings"
            android:tint="@color/fg"
            android:contentDescription="Ayarlar" />
    </LinearLayout>
</LinearLayout>
