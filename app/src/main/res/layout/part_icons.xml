<?xml version="1.0" encoding="utf-8"?>
<!-- Hızlı düğmeler iki sıra halinde (hızlı rotalar koddan eklenir). Görünen düğmeler koddan iki sıraya eşit dağıtılır. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/iconsGrid"
    android:layout_width="match_parent"
    android:layout_height="104dp"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/iconsRow1"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/weatherTile"
            style="@style/QuickText"
            android:textSize="17sp"
            android:clickable="false"
            android:focusable="false"
            android:contentDescription="Hava durumu"
            android:text="–" />

        <!-- Durum: çekim, Bluetooth, pil (iki düğme genişliğinde) -->
        <LinearLayout
            android:id="@+id/statusTile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="2"
            android:background="@drawable/btn_outline"
            android:orientation="horizontal"
            android:gravity="center">
            <ImageView
                android:id="@+id/signalIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="8dp"
                android:src="@drawable/ic_signal_0"
                android:tint="@color/muted"
                android:contentDescription="Şebeke çekimi" />
            <ImageView
                android:id="@+id/btIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="8dp"
                android:src="@drawable/ic_bluetooth"
                android:tint="@color/muted"
                android:visibility="gone"
                android:contentDescription="Bluetooth" />
            <ImageView
                android:id="@+id/battIcon"
                android:layout_width="25dp"
                android:layout_height="19dp"
                android:src="@drawable/battery_level"
                android:tint="@color/muted"
                android:contentDescription="Pil" />
            <TextView
                android:id="@+id/battText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/muted"
                android:singleLine="true"
                android:fontFeatureSettings="tnum" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/assistBtn"
            style="@style/QuickIcon"
            android:src="@drawable/ic_mic"
            android:tint="@color/amber"
            android:contentDescription="Sesli asistan" />

        <TextView
            android:id="@+id/call1Btn"
            style="@style/QuickText"
            android:visibility="gone" />

        <TextView
            android:id="@+id/call2Btn"
            style="@style/QuickText"
            android:visibility="gone" />
        <TextView
            android:id="@+id/call3Btn"
            style="@style/QuickText"
            android:visibility="gone" />
        <TextView
            android:id="@+id/call4Btn"
            style="@style/QuickText"
            android:visibility="gone" />
        <TextView
            android:id="@+id/call5Btn"
            style="@style/QuickText"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/iconsRow2"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/parkBtn"
            style="@style/QuickIcon"
            android:src="@drawable/ic_car"
            android:tint="@color/fg"
            android:contentDescription="Arabam nerede" />

        <ImageButton
            android:id="@+id/settingsBtn"
            style="@style/QuickIcon"
            android:src="@drawable/ic_settings"
            android:tint="@color/muted"
            android:contentDescription="Ayarlar" />
    </LinearLayout>
</LinearLayout>
