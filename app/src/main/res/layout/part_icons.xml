<?xml version="1.0" encoding="utf-8"?>
<!-- Hızlı düğmeler iki sıra halinde (hızlı rotalar koddan eklenir). Görünen düğmeler koddan iki sıraya eşit dağıtılır. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/iconsGrid"
    android:layout_width="match_parent"
    android:layout_height="140dp"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/iconsRow1"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/assistBtn"
            style="@style/QuickIcon"
            android:src="@drawable/ic_mic"
            android:tint="@color/amber"
            android:contentDescription="Sesli asistan" />

        <TextView
            android:id="@+id/call1Btn"
            style="@style/QuickText"
            android:visibility="gone" />

        <TextView
            android:id="@+id/call2Btn"
            style="@style/QuickText"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/iconsRow2"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/parkBtn"
            style="@style/QuickIcon"
            android:src="@drawable/ic_car"
            android:tint="@color/fg"
            android:contentDescription="Arabam nerede" />

        <ImageButton
            android:id="@+id/settingsBtn"
            style="@style/QuickIcon"
            android:src="@drawable/ic_settings"
            android:tint="@color/muted"
            android:contentDescription="Ayarlar" />
    </LinearLayout>
</LinearLayout>
