<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ayarlar"
            android:fontFamily="sans-serif-condensed"
            android:textStyle="bold"
            android:textSize="36sp"
            android:textColor="@color/fg" />

        <!-- Uygulamalar -->
        <TextView style="@style/SectionTitle" android:text="Harici navigasyon uygulaması" />
        <RadioGroup android:id="@+id/radioNav" android:layout_width="match_parent" android:layout_height="wrap_content">
            <RadioButton android:id="@+id/rbMaps" style="@style/Option" android:text="Google Maps" />
            <RadioButton android:id="@+id/rbYandex" style="@style/Option" android:text="Yandex Haritalar" />
        </RadioGroup>
        <TextView style="@style/SectionTitle" android:text="Ana ekran düğmeleri" />
        <Switch android:id="@+id/swAssist" style="@style/Toggle"
            android:text="Sesli asistan (mikrofon) düğmesi" />
        <Switch android:id="@+id/swAutoSplit" style="@style/Toggle" android:layout_marginTop="6dp"
            android:text="Açılınca haritayı yan yana başlat" />
        <TextView style="@style/Note"
            android:text="Haritanın ekrandaki payını ortadaki ayırma çizgisini sürükleyerek ayarlayabilirsin." />

        <TextView style="@style/SectionTitle" android:text="Müzik uygulaması" />
        <RadioGroup android:id="@+id/radioMusic" android:layout_width="match_parent" android:layout_height="wrap_content">
            <RadioButton android:id="@+id/rbSpotify" style="@style/Option" android:text="Spotify" />
            <RadioButton android:id="@+id/rbYtm" style="@style/Option" android:text="YouTube Music" />
        </RadioGroup>

        <TextView style="@style/SectionTitle" android:text="Ekran ölçeği" />
        <RadioGroup android:id="@+id/radioScale" android:layout_width="match_parent" android:layout_height="wrap_content">
            <RadioButton android:id="@+id/rbScaleXS" style="@style/Option" android:text="Çok küçük" />
            <RadioButton android:id="@+id/rbScaleS" style="@style/Option" android:text="Küçük" />
            <RadioButton android:id="@+id/rbScaleM" style="@style/Option" android:text="Normal" />
            <RadioButton android:id="@+id/rbScaleL" style="@style/Option" android:text="Büyük" />
        </RadioGroup>

        <TextView style="@style/SectionTitle" android:text="Mesafe birimi" />
        <RadioGroup android:id="@+id/radioUnits" android:layout_width="match_parent" android:layout_height="wrap_content">
            <RadioButton android:id="@+id/rbMiles" style="@style/Option" android:text="Mil / fit" />
            <RadioButton android:id="@+id/rbKm" style="@style/Option" android:text="Kilometre / metre" />
        </RadioGroup>

        <!-- Adresler -->
        <TextView style="@style/SectionTitle" android:text="Hızlı arama (en fazla 5)" />
        <TextView style="@style/Note" android:layout_marginTop="0dp"
            android:text="Seçtiğin kişiler ana ekranda düğme olur; dokununca doğrudan aranır. Değiştirmek için tekrar seç, kaldırmak için basılı tut." />
        <Button android:id="@+id/call1Pick" style="@style/OutlineBtn" android:layout_width="match_parent"
            android:layout_marginTop="10dp" />
        <Button android:id="@+id/call2Pick" style="@style/OutlineBtn" android:layout_width="match_parent"
            android:layout_marginTop="10dp" />
        <Button android:id="@+id/call3Pick" style="@style/OutlineBtn" android:layout_width="match_parent"
            android:layout_marginTop="10dp" />
        <Button android:id="@+id/call4Pick" style="@style/OutlineBtn" android:layout_width="match_parent"
            android:layout_marginTop="10dp" />
        <Button android:id="@+id/call5Pick" style="@style/OutlineBtn" android:layout_width="match_parent"
            android:layout_marginTop="10dp" />

        <TextView style="@style/SectionTitle" android:text="Hızlı rotalar (en fazla 5)" />
        <TextView style="@style/Note" android:layout_marginTop="0dp"
            android:text="Eklediğin yerler ana ekranda simgeleriyle düğme olur; dokununca o yere rota başlar. Bir rotaya dokunarak adını, simgesini, konumunu değiştirebilir ya da silebilirsin." />
        <LinearLayout
            android:id="@+id/placesList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <!-- Araba -->
        <TextView style="@style/SectionTitle" android:text="Araba Bluetooth'u" />
        <TextView android:id="@+id/carStatus" style="@style/Note" android:layout_marginTop="0dp"
            android:textColor="@color/fg" android:textSize="17sp" />
        <Button android:id="@+id/carBtn" style="@style/OutlineBtn" android:layout_width="match_parent"
            android:layout_marginTop="10dp" android:text="Arabayı seç" />
        <Switch android:id="@+id/swAutoOpen" style="@style/Toggle" android:layout_marginTop="10dp"
            android:text="Bağlanınca otomatik aç" />
        <Switch android:id="@+id/swAutoPlay" style="@style/Toggle"
            android:text="Bağlanınca müziği devam ettir" />

        <!-- İzinler -->
        <TextView style="@style/SectionTitle" android:text="İzinler" />
        <TextView style="@style/Note" android:layout_marginTop="0dp"
            android:text="Otomatik açılma, harita ve çalan şarkı için gereken izinler. Sırayla bas." />

        <Button android:id="@+id/overlayBtn" style="@style/OutlineBtn" android:layout_width="match_parent"
            android:layout_marginTop="14dp" android:text="1. Diğer uygulamaların üzerinde göster" />
        <TextView android:id="@+id/overlayStatus" style="@style/Note" />

        <Button android:id="@+id/xiaomiBtn" style="@style/OutlineBtn" android:layout_width="match_parent"
            android:layout_marginTop="14dp" android:text="2. Xiaomi izinleri" />
        <TextView style="@style/Note"
            android:text="Açılan ekranda: Arka planda çalışırken açılır pencereleri göster, Kilit ekranında göster ve Otomatik başlatma → İzin ver. Pil tasarrufunu da Kısıtlama yok yap." />

        <Button android:id="@+id/notifBtn" style="@style/OutlineBtn" android:layout_width="match_parent"
            android:layout_marginTop="14dp" android:text="3. Bildirimler (yedek)" />
        <TextView android:id="@+id/notifStatus" style="@style/Note" />

        <Button android:id="@+id/listenerBtn" style="@style/OutlineBtn" android:layout_width="match_parent"
            android:layout_marginTop="14dp" android:text="4. Bildirim erişimi (şarkı ve yön)" />
        <TextView android:id="@+id/listenerStatus" style="@style/Note" />
        <TextView style="@style/Note"
            android:text="Açılan listede Sürüş Ekranı gri ve kapalıysa: 5 numaralı butona bas, sağ üstteki üç noktadan Kısıtlı ayarlara izin ver de, sonra 4'ü tekrar dene." />
        <Button android:id="@+id/appInfoBtn" style="@style/OutlineBtn" android:layout_width="match_parent"
            android:layout_marginTop="10dp" android:text="5. Uygulama bilgisi" />

        <!-- Ana ekran -->
        <TextView style="@style/SectionTitle" android:text="Ana ekran" />
        <Switch android:id="@+id/swLauncher" style="@style/Toggle"
            android:text="Ana ekran olarak kullanılabilsin" />
        <TextView style="@style/Note"
            android:text="Açınca telefon hangi ana ekranı kullanacağını sorar. Eski ana ekranına dönmek için aşağıdaki butondan HyperOS'u seç." />
        <Button android:id="@+id/homeAppBtn" style="@style/OutlineBtn" android:layout_width="match_parent"
            android:layout_marginTop="10dp" android:text="Varsayılan ana ekranı değiştir" />

        <Button android:id="@+id/backBtn" style="@style/OutlineBtn" android:layout_width="match_parent"
            android:layout_marginTop="32dp" android:background="@drawable/tile_amber"
            android:textColor="@color/amber_ink" android:text="Kaydet ve dön" />
    </LinearLayout>
</ScrollView>
