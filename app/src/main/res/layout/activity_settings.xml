<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/settingsRoot"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingEnd="14dp"
        android:paddingTop="16dp"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="Ayarlar"
            android:fontFamily="sans-serif-condensed"
            android:textStyle="bold"
            android:textSize="36sp"
            android:textColor="@color/fg" />

        <Button android:id="@+id/featuresBtn" style="@style/OutlineBtn" android:textSize="16sp"
            android:layout_width="match_parent" android:layout_marginTop="14dp"
            android:text="💡 Neler yapabilirim?" />



        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:layout_marginTop="28dp" android:background="#22FFFFFF" />

        <!-- Araba ve Bluetooth: hepsi tek bölümde -->
        <TextView style="@style/SectionTitle" android:text="Araba ve Bluetooth" />
        <!-- Seçili araba düğmenin içinde; sağda "Değiştir" -->
        <LinearLayout android:id="@+id/carBtn" android:layout_width="match_parent" android:layout_height="60dp"
            android:layout_marginTop="10dp" android:orientation="horizontal" android:gravity="center_vertical"
            android:background="@drawable/btn_outline" android:clickable="true" android:focusable="true"
            android:paddingStart="14dp" android:paddingEnd="14dp">
            <ImageView android:id="@+id/carIcon" android:layout_width="24dp" android:layout_height="24dp"
                android:src="@drawable/ic_bluetooth" android:tint="@color/accent" android:contentDescription="Bluetooth" />
            <TextView android:id="@+id/carName" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:layout_marginStart="12dp"
                android:textSize="16sp" android:textColor="@color/fg" android:singleLine="true"
                android:ellipsize="end" android:text="Arabayı seç" />
            <TextView android:id="@+id/carChange" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="14sp" android:textStyle="bold" android:textColor="@color/amber" android:text="Değiştir" />
        </LinearLayout>

        <TextView style="@style/SubTitle" android:text="Arabaya bağlanınca" />
        <Switch android:id="@+id/swAutoOpen" style="@style/Toggle" android:text="Kopilot'u aç" />
        <Switch android:id="@+id/swAutoPlay" style="@style/Toggle" android:text="Müziği devam ettir" />
        <Switch android:id="@+id/swCarVol" style="@style/Toggle" android:text="Müzik sesini ayarla" />
        <LinearLayout
            android:id="@+id/carVolRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <SeekBar
                android:id="@+id/carVolSeek"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:max="100"
                android:progressTint="@color/accent"
                android:progressBackgroundTint="@color/line"
                android:thumbTint="@color/accent" />
            <TextView
                android:id="@+id/carVolText"
                android:layout_width="56dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:textSize="17sp"
                android:textColor="@color/fg" />
        </LinearLayout>

        <TextView style="@style/SubTitle" android:text="Bluetooth" />
        <Switch android:id="@+id/swBtOnOpen" style="@style/Toggle" android:text="Kopilot açılınca aç" />
        <Switch android:id="@+id/swBtOff" style="@style/Toggle" android:text="Arabadan inince kapat" />
        <Switch android:id="@+id/swCarLink" style="@style/Toggle" android:text="Araba bağlanmazsa Kopilot bağlasın" />

        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:layout_marginTop="28dp" android:background="#22FFFFFF" />

        <!-- 2. Uygulamalar -->
        <TextView style="@style/SectionTitle" android:text="Navigasyon uygulaması" />
        <RadioGroup android:id="@+id/radioNav" android:layout_width="match_parent" android:layout_height="wrap_content">
            <RadioButton android:id="@+id/rbMaps" style="@style/Option" android:text="Google Maps" />
            <RadioButton android:id="@+id/rbYandex" style="@style/Option" android:text="Yandex Haritalar" />
        </RadioGroup>
        <Switch android:id="@+id/swAutoSplit" style="@style/Toggle" android:layout_marginTop="14dp"
            android:text="Açılınca haritayı yan yana başlat" />

        <TextView style="@style/SectionTitle" android:text="Müzik uygulaması" />
        <TextView style="@style/Note" android:layout_marginTop="0dp"
            android:text="Ana ekrandaki müzik kutusunu sola kaydırınca sonraki, sağa kaydırınca önceki şarkıya geçer." />
        <RadioGroup android:id="@+id/radioMusic" android:layout_width="match_parent" android:layout_height="wrap_content">
            <RadioButton android:id="@+id/rbSpotify" style="@style/Option" android:text="Spotify" />
            <RadioButton android:id="@+id/rbYtm" style="@style/Option" android:text="YouTube Music" />
        </RadioGroup>

        <TextView style="@style/SectionTitle" android:text="Uygulama kısayolları" />
        <TextView style="@style/Note" android:layout_marginTop="0dp"
            android:text="Seçtiğin uygulamalar ana ekranda müzik çaların altında görünür; kaç tane seçersen o kadar kutu olur (en fazla 4). En sağda her zaman Ayarlar düğmesi durur. Sırasını değiştirmek için soldaki ≡ işaretinden tutup sürükle." />
        <LinearLayout
            android:id="@+id/appsList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />


        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:layout_marginTop="28dp" android:background="#22FFFFFF" />

        <!-- Kişiler ve yerler -->
        <TextView style="@style/SectionTitle" android:text="Hızlı arama (en fazla 5)" />
        <TextView style="@style/Note" android:layout_marginTop="0dp"
            android:text="Eklediğin kişiler hızlı arama için ana ekrana gelir. Dokunduktan sonra iptal için 3 saniye süre başlar, iptal etmezsen arama başlar. Tuşa uzun basarsan ilgili kişiye WhatsApp üzerinden &quot;Yoldayım. İşte konumum&quot; mesajı ile anlık konumun gönderilir. Sırasını değiştirmek için ≡ işaretinden tutup sürükle." />
        <LinearLayout
            android:id="@+id/callsList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView style="@style/SectionTitle" android:text="Hızlı rotalar (en fazla 5)" />
        <TextView style="@style/Note" android:layout_marginTop="0dp"
            android:text="Eklediğin yerler ana ekranda simgeleriyle düğme olur; dokununca o yere rota başlar. Simgesine dokunarak simgesini değiştir; sırasını değiştirmek için ≡ işaretinden tutup sürükle." />
        <LinearLayout
            android:id="@+id/placesList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />


        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:layout_marginTop="28dp" android:background="#22FFFFFF" />

        <!-- 4. Ana ekran görünümü -->
        <TextView style="@style/SectionTitle" android:text="Ana ekran düğmeleri" />
        <TextView style="@style/Note" android:layout_marginTop="0dp"
            android:text="Gizle/Göster ile aç-kapat, Üst sıra/Alt sıra ile hangi satırda duracağını seç. Sırasını değiştirmek için soldaki ≡ işaretinden tutup sürükle." />
        <LinearLayout
            android:id="@+id/layoutList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
        <TextView android:id="@+id/layoutReset" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="end" android:layout_marginTop="8dp" android:padding="8dp"
            android:background="?android:attr/selectableItemBackground"
            android:textSize="14sp" android:textColor="@color/amber" android:text="Varsayılan düzene dön" />

        <TextView style="@style/SectionTitle" android:text="Bildirim kutusu" />
        <TextView style="@style/Note" android:layout_marginTop="0dp"
            android:text="Hangi uygulamaların bildirimleri ana ekrandaki kutuda görünsün, sen seç. Seçmediklerin telefona her zamanki gibi gelir." />
        <!-- Seçili uygulamaların simgeleri; sağda "Değiştir" -->
        <LinearLayout android:id="@+id/notifAppsBtn" android:layout_width="match_parent" android:layout_height="60dp"
            android:layout_marginTop="10dp" android:orientation="horizontal" android:gravity="center_vertical"
            android:background="@drawable/btn_outline" android:clickable="true" android:focusable="true"
            android:paddingStart="14dp" android:paddingEnd="14dp">
            <LinearLayout android:id="@+id/notifAppsIcons" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="match_parent" android:orientation="horizontal" android:gravity="center_vertical" />
            <TextView android:id="@+id/notifAppsChange" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="8dp" android:textSize="14sp" android:textStyle="bold"
                android:textColor="@color/amber" android:text="Değiştir" />
        </LinearLayout>
        <Switch android:id="@+id/swMissed" style="@style/Toggle" android:layout_marginTop="6dp"
            android:text="Cevapsız aramalar da gelsin" />

        <TextView style="@style/SectionTitle" android:text="Ekran ölçeği" />
        <TextView style="@style/Note" android:layout_marginTop="0dp"
            android:text="Çubuğu sağa ya da sola kaydırarak ana ekrandaki her şeyi büyütüp küçült." />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <SeekBar
                android:id="@+id/scaleSeek"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:max="10"
                android:progressTint="@color/accent"
                android:progressBackgroundTint="@color/line"
                android:thumbTint="@color/accent" />
            <TextView
                android:id="@+id/scaleText"
                android:layout_width="64dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:textSize="17sp"
                android:textColor="@color/fg" />
        </LinearLayout>


        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:layout_marginTop="28dp" android:background="#22FFFFFF" />

        <!-- Sürüş yardımı -->
        <TextView style="@style/SectionTitle" android:text="Sürüş yardımı" />
        <Switch android:id="@+id/swWave" style="@style/Toggle"
            android:text="El sallayarak kontrol" />
        <TextView style="@style/Note" android:layout_marginTop="0dp"
            android:text="Yolda telefona dokunmadan iş gör: elini ön kameranın hemen üzerinden bir ya da iki kez geçirmen yeter. Hangi hareketin ne yapacağını aşağıdan sen seç; şarkı geçmek, son mesajı sesli dinlemek ya da sesi kapatmak gibi. Kopilot ekrandayken çalışır." />
        <TextView android:id="@+id/wave1Btn" style="@style/Option"
            android:layout_height="wrap_content" android:minHeight="52dp"
            android:gravity="center_vertical" android:paddingVertical="8dp"
            android:background="?android:attr/selectableItemBackground" />
        <TextView android:id="@+id/wave2Btn" style="@style/Option"
            android:layout_height="wrap_content" android:minHeight="52dp"
            android:gravity="center_vertical" android:paddingVertical="8dp"
            android:background="?android:attr/selectableItemBackground" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="8dp">
            <TextView android:id="@+id/notesBtn" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:padding="8dp"
                android:background="?android:attr/selectableItemBackground"
                android:textSize="14sp" android:textColor="@color/amber" android:text="Sesli notlarım" />
            <TextView android:id="@+id/tipsReset" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:padding="8dp"
                android:background="?android:attr/selectableItemBackground"
                android:textSize="14sp" android:textColor="@color/amber" android:text="İpuçlarını yeniden göster" />
        </LinearLayout>


        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:layout_marginTop="28dp" android:background="#22FFFFFF" />

        <!-- İzinler -->
        <TextView style="@style/SectionTitle" android:text="İzinler" />
        <TextView style="@style/Note" android:layout_marginTop="0dp"
            android:text="Otomatik açılma, harita ve çalan şarkı için gereken izinler. Sırayla bas." />

        <Button android:id="@+id/overlayBtn" style="@style/OutlineBtn" android:textSize="16sp" android:layout_width="match_parent"
            android:layout_marginTop="14dp" android:text="1. Diğer uygulamaların üzerinde göster" />
        <TextView android:id="@+id/overlayStatus" style="@style/Note" />

        <Button android:id="@+id/xiaomiBtn" style="@style/OutlineBtn" android:textSize="16sp" android:layout_width="match_parent"
            android:layout_marginTop="14dp" android:text="2. Xiaomi izinleri" />
        <TextView style="@style/Note"
            android:text="Açılan ekranda: Arka planda çalışırken açılır pencereleri göster, Kilit ekranında göster ve Otomatik başlatma → İzin ver. Pil tasarrufunu da Kısıtlama yok yap." />

        <Button android:id="@+id/notifBtn" style="@style/OutlineBtn" android:textSize="16sp" android:layout_width="match_parent"
            android:layout_marginTop="14dp" android:text="3. Bildirimler (yedek)" />
        <TextView android:id="@+id/notifStatus" style="@style/Note" />

        <Button android:id="@+id/listenerBtn" style="@style/OutlineBtn" android:textSize="16sp" android:layout_width="match_parent"
            android:layout_marginTop="14dp" android:text="4. Bildirim erişimi (şarkı ve yön)" />
        <TextView android:id="@+id/listenerStatus" style="@style/Note" />
        <TextView style="@style/Note"
            android:text="Açılan listede Kopilot gri ve kapalıysa: 5 numaralı butona bas, sağ üstteki üç noktadan Kısıtlı ayarlara izin ver de, sonra 4'ü tekrar dene." />
        <Button android:id="@+id/appInfoBtn" style="@style/OutlineBtn" android:textSize="16sp" android:layout_width="match_parent"
            android:layout_marginTop="10dp" android:text="5. Uygulama bilgisi" />

        <Button android:id="@+id/backBtn" style="@style/OutlineBtn" android:textSize="16sp" android:layout_width="match_parent"
            android:layout_marginTop="32dp" android:background="@drawable/tile_accent"
            android:textColor="@color/accent_ink" android:text="Geri dön" />
        <TextView android:id="@+id/versionText" style="@style/Note" android:gravity="center"
            android:layout_marginTop="12dp" />
    </LinearLayout>
</ScrollView>
