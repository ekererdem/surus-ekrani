<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ayarlar"
            android:fontFamily="sans-serif-condensed"
            android:textStyle="bold"
            android:textSize="36sp"
            android:textColor="@color/fg" />

        <!-- Uygulamalar -->
        <TextView style="@style/SectionTitle" android:text="Navigasyon uygulaması" />
        <RadioGroup android:id="@+id/radioNav" android:layout_width="match_parent" android:layout_height="wrap_content">
            <RadioButton android:id="@+id/rbMaps" style="@style/Option" android:text="Google Maps" />
            <RadioButton android:id="@+id/rbWaze" style="@style/Option" android:text="Waze" />
        </RadioGroup>

        <TextView style="@style/SectionTitle" android:text="Müzik uygulaması" />
        <RadioGroup android:id="@+id/radioMusic" android:layout_width="match_parent" android:layout_height="wrap_content">
            <RadioButton android:id="@+id/rbSpotify" style="@style/Option" android:text="Spotify" />
            <RadioButton android:id="@+id/rbYtm" style="@style/Option" android:text="YouTube Music" />
        </RadioGroup>

        <!-- Adresler -->
        <TextView style="@style/SectionTitle" android:text="Kısayol adresleri" />
        <TextView style="@style/Note" android:text="Ev" />
        <EditText android:id="@+id/editHome" style="@style/Field" android:hint="Örn. 1200 Main St, Houston, TX" />
        <TextView style="@style/Note" android:layout_marginTop="14dp" android:text="İş" />
        <EditText android:id="@+id/editWork" style="@style/Field" android:hint="Örn. Downtown Austin, TX" />

        <!-- Araba -->
        <TextView style="@style/SectionTitle" android:text="Araba Bluetooth'u" />
        <TextView android:id="@+id/carStatus" style="@style/Note" android:layout_marginTop="0dp"
            android:textColor="@color/fg" android:textSize="17sp" />
        <Button android:id="@+id/carBtn" style="@style/OutlineBtn" android:layout_width="match_parent"
            android:layout_marginTop="10dp" android:text="Arabayı seç" />
        <Switch android:id="@+id/swAutoOpen" style="@style/Toggle" android:layout_marginTop="10dp"
            android:text="Bağlanınca otomatik aç" />
        <Switch android:id="@+id/swAutoPlay" style="@style/Toggle"
            android:text="Bağlanınca müziği devam ettir" />

        <!-- İzinler -->
        <TextView style="@style/SectionTitle" android:text="Otomatik açılma izinleri" />
        <TextView style="@style/Note" android:layout_marginTop="0dp"
            android:text="Xiaomi'de uygulamanın arka plandan açılabilmesi için üç ayar gerekli. Sırayla bas." />

        <Button android:id="@+id/overlayBtn" style="@style/OutlineBtn" android:layout_width="match_parent"
            android:layout_marginTop="14dp" android:text="1. Diğer uygulamaların üzerinde göster" />
        <TextView android:id="@+id/overlayStatus" style="@style/Note" />

        <Button android:id="@+id/xiaomiBtn" style="@style/OutlineBtn" android:layout_width="match_parent"
            android:layout_marginTop="14dp" android:text="2. Xiaomi izinleri" />
        <TextView style="@style/Note"
            android:text="Açılan ekranda: Arka planda çalışırken açılır pencereleri göster, Kilit ekranında göster ve Otomatik başlatma → İzin ver. Pil tasarrufunu da Kısıtlama yok yap." />

        <Button android:id="@+id/notifBtn" style="@style/OutlineBtn" android:layout_width="match_parent"
            android:layout_marginTop="14dp" android:text="3. Bildirimler (yedek)" />
        <TextView android:id="@+id/notifStatus" style="@style/Note" />

        <!-- Ana ekran -->
        <TextView style="@style/SectionTitle" android:text="Ana ekran" />
        <Switch android:id="@+id/swLauncher" style="@style/Toggle"
            android:text="Ana ekran olarak kullanılabilsin" />
        <TextView style="@style/Note"
            android:text="Açınca telefon hangi ana ekranı kullanacağını sorar. Eski ana ekranına dönmek için aşağıdaki butondan HyperOS'u seç." />
        <Button android:id="@+id/homeAppBtn" style="@style/OutlineBtn" android:layout_width="match_parent"
            android:layout_marginTop="10dp" android:text="Varsayılan ana ekranı değiştir" />

        <Button android:id="@+id/backBtn" style="@style/OutlineBtn" android:layout_width="match_parent"
            android:layout_marginTop="32dp" android:background="@drawable/tile_amber"
            android:textColor="@color/amber_ink" android:text="Kaydet ve dön" />
    </LinearLayout>
</ScrollView>
