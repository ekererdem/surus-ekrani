<?xml version="1.0" encoding="utf-8"?>
<!-- Navigasyon uygulamasının üstünde duran küçük müzik çubuğu -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <LinearLayout
        android:id="@+id/fBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/float_bg"
        android:paddingStart="12dp"
        android:paddingEnd="6dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextClock
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="HH:mm"
                android:format24Hour="HH:mm"
                android:fontFamily="sans-serif-condensed"
                android:textStyle="bold"
                android:textSize="20sp"
                android:textColor="@color/fg"
                android:includeFontPadding="false" />
            <TextView
                android:id="@+id/fWeather"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="@color/muted"
                android:singleLine="true" />
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="34dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:background="@color/line" />

        <LinearLayout
            android:layout_width="150dp"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:id="@+id/fTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/fg"
                android:singleLine="true"
                android:ellipsize="end"
                android:text="Müzik" />
            <TextView
                android:id="@+id/fArtist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="@color/muted"
                android:singleLine="true"
                android:ellipsize="end" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/fPrev"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/btn_outline"
            android:src="@drawable/ic_prev"
            android:tint="@color/fg"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:contentDescription="Önceki" />
        <ImageButton
            android:id="@+id/fPlay"
            android:layout_width="50dp"
            android:layout_height="42dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/tile_amber"
            android:src="@drawable/ic_play"
            android:tint="@color/amber_ink"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:contentDescription="Oynat / Duraklat" />
        <ImageButton
            android:id="@+id/fNext"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/btn_outline"
            android:src="@drawable/ic_next"
            android:tint="@color/fg"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:contentDescription="Sonraki" />
        <ImageButton
            android:id="@+id/fMin"
            android:layout_width="34dp"
            android:layout_height="42dp"
            android:layout_marginStart="4dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_minus"
            android:tint="@color/muted"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:contentDescription="Küçült" />
        <ImageButton
            android:id="@+id/fClose"
            android:layout_width="34dp"
            android:layout_height="42dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_close"
            android:tint="@color/muted"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:contentDescription="Kapat" />
    </LinearLayout>

    <ImageView
        android:id="@+id/fBubble"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/bubble_bg"
        android:src="@drawable/ic_music"
        android:tint="@color/amber_ink"
        android:padding="15dp"
        android:visibility="gone"
        android:contentDescription="Müzik çubuğunu aç" />
</FrameLayout>
