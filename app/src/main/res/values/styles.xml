<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <!-- Yatayda kamera çentiğinin olduğu kenarı da kullan -->
        <item name="android:windowLayoutInDisplayCutoutMode">always</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:textColorPrimary">@color/fg</item>
        <item name="android:textColorSecondary">@color/muted</item>
        <item name="kAccent">@color/accent</item>
        <item name="kAccentInk">@color/accent_ink</item>
        <item name="kAccentSoft">#801DB9AA</item>
    </style>

    <!-- Vurgu rengi seçenekleri (Turkuaz = AppTheme, logodaki renk) -->
    <style name="AppTheme.Gold">
        <item name="android:colorAccent">#F5A623</item>
        <item name="kAccent">#F5A623</item>
        <item name="kAccentInk">#2B1A00</item>
        <item name="kAccentSoft">#80F5A623</item>
    </style>
    <style name="AppTheme.Blue">
        <item name="android:colorAccent">#3B82F6</item>
        <item name="kAccent">#3B82F6</item>
        <item name="kAccentInk">#FFFFFF</item>
        <item name="kAccentSoft">#803B82F6</item>
    </style>
    <style name="AppTheme.Green">
        <item name="android:colorAccent">#22C55E</item>
        <item name="kAccent">#22C55E</item>
        <item name="kAccentInk">#062B14</item>
        <item name="kAccentSoft">#8022C55E</item>
    </style>
    <style name="AppTheme.Coral">
        <item name="android:colorAccent">#F2545B</item>
        <item name="kAccent">#F2545B</item>
        <item name="kAccentInk">#FFFFFF</item>
        <item name="kAccentSoft">#80F2545B</item>
    </style>
    <style name="AppTheme.Purple">
        <item name="android:colorAccent">#8B5CF6</item>
        <item name="kAccent">#8B5CF6</item>
        <item name="kAccentInk">#FFFFFF</item>
        <item name="kAccentSoft">#808B5CF6</item>
    </style>

    <style name="TileTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textSize">40sp</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="TileSub">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">16sp</item>
        <item name="android:alpha">0.75</item>
        <item name="android:layout_marginTop">4dp</item>
    </style>

    <style name="ChipTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/fg</item>
    </style>

    <style name="ChipSub">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/muted</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="OutlineBtn">
        <item name="android:layout_height">60dp</item>
        <item name="android:background">@drawable/btn_outline</item>
        <item name="android:textColor">@color/fg</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="SectionTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">?attr/kAccent</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:layout_marginTop">30dp</item>
        <item name="android:layout_marginBottom">8dp</item>
    </style>

    <!-- Bölümler arası ince çizgi -->
    <style name="Divider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_marginTop">28dp</item>
        <item name="android:background">@color/line</item>
        <item name="android:alpha">0.6</item>
    </style>

    <!-- Dokunulabilir satır kartı (Neler yapabilirim, izinler…) -->
    <style name="RowCard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">60dp</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:background">@drawable/btn_outline</item>
        <item name="android:foreground">?android:attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
    </style>

    <!-- Bölüm içindeki küçük ara başlık (ör. "Arabaya bağlanınca") -->
    <style name="SubTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">18dp</item>
        <item name="android:layout_marginBottom">2dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/muted</item>
    </style>

    <style name="Note">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/muted</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
        <item name="android:layout_marginTop">6dp</item>
    </style>

    <style name="Field">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/field_bg</item>
        <item name="android:padding">14dp</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/fg</item>
        <item name="android:textColorHint">@color/muted</item>
        <item name="android:inputType">textPostalAddress</item>
        <item name="android:layout_marginTop">8dp</item>
    </style>

    <style name="Option">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/fg</item>
        <item name="android:buttonTint">?attr/kAccent</item>
    </style>

    <style name="Toggle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/fg</item>
        <item name="android:thumbTint">@color/switch_thumb</item>
        <item name="android:trackTint">@color/switch_track</item>
    </style>

    <style name="QuickIcon">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/btn_outline</item>
        <item name="android:padding">14dp</item>
        <item name="android:scaleType">fitCenter</item>
    </style>

    <style name="QuickText">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/btn_outline</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">6dp</item>
        <item name="android:paddingEnd">6dp</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/fg</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
</resources>
